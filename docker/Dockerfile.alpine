FROM alpine:3.24 AS build
RUN apk add --no-cache --upgrade \
    php85 \
    php85-dom \
    php85-gd \
    php85-intl \
    php85-pdo_sqlite \
    php85-xml \
    php85-zip \
    php85-phar \
    composer \
    icu-data-full \
    php85-ctype \
    php85-curl \
    php85-fileinfo \
    php85-iconv \
    php85-mbstring \
    php85-openssl \
    php85-session \
    php85-tokenizer \
    php85-xmlwriter
# https://www.dannyvankooten.com/blog/2025/composer-php-version-alpine-linux/
#RUN sed -i 's/php83/php85/g' /usr/bin/composer

WORKDIR /app
COPY . /app
RUN composer install --no-dev -o -d /app

ENV PORT=80
EXPOSE $PORT

CMD ["sh", "-c", "php85 -S 0.0.0.0:$PORT -t /app"]

FROM build AS dev-envs
RUN composer update -o -d /app
#RUN apk --no-cache add nodejs yarn
#RUN yarn
